{
  "name": "biblio-sphere",
  "version": "0.0.1",
  "description": "digital world of books",
  "main": "dist/desktop/main/index.js",
  "scripts": {
    "test": "node --max-old-space-size=4096 ./node_modules/.bin/jest --config .config/jest.config.js",
    "build": "tsc --project .config/tsconfig.json",
    "lint": "eslint src/ --config .config/eslint.config.mjs",
    "demo": "ts-node --project .config/tsconfig.json src/bin/demo.ts",
    "desktop": "electron-vite dev --config desktop/electron.vite.config.ts",
    "dev:web": "vite desktop/renderer --host 127.0.0.1",
    "typecheck:desktop": "tsc --project desktop/tsconfig.json --noEmit",
    "lint:desktop": "eslint desktop --config desktop/eslint.config.mjs",
    "build:desktop": "npm run typecheck:desktop && electron-vite build --config desktop/electron.vite.config.ts",
    "package:mac": "npm run build:desktop && electron-builder --mac",
    "package:dir": "npm run build:desktop && electron-builder --dir",
    "test:desktop": "playwright test --config desktop/playwright.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "io.bibliosphere.desktop",
    "productName": "BiblioSphere",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.books",
      "icon": "desktop/renderer/public/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "dmg": {
      "title": "BiblioSphere"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheNewThinkTank/biblio-sphere.git"
  },
  "author": "Gustav Rasmussen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TheNewThinkTank/biblio-sphere/issues"
  },
  "homepage": "https://github.com/TheNewThinkTank/biblio-sphere#readme",
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "googleapis": "^169.0.0",
    "lodash": "^4.17.21",
    "lucide": "^1.57.0",
    "page-flip": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/page-flip": "^2.0.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^8.3.4"
  }
}
